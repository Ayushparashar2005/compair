---
import '../../styles/global.css';
import VgpuBackground from './VgpuBackground';
import { TransitionCanvas } from './TransitionCanvas';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const { title, description = "Real facts. Real numbers. One guess. A knowledge comparison game.", ogImage = "/favicon.svg", ogType = "website" } = Astro.props;
const pathname = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - ComPair</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} - ComPair`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <TransitionCanvas client:only="react" />
    <VgpuBackground client:only="react" />
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-[var(--color-brand-accent)] text-white font-mono font-bold px-4 py-2 z-[60] border-4 border-black shadow-[4px_4px_0_#000] outline-none">
      Skip to main content
    </a>
    <header class="w-full border-b-4 border-black bg-white text-black sticky top-0 z-50 shadow-[0_2px_0_#000]">
      <div class="w-full px-6 h-16 flex items-center justify-between">
        <a href="/" class="text-2xl font-display font-black tracking-tighter uppercase relative group">
          Com<span class="text-[var(--color-brand-accent)]">Pair</span>
        </a>
        
        <button id="mobile-menu-btn" class="md:hidden p-2 border-2 border-black" aria-label="Menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>

        <nav id="main-nav" class="hidden md:flex absolute top-16 left-0 w-full bg-white border-b-4 border-black md:border-none md:static md:w-auto md:bg-transparent flex-col md:flex-row items-center gap-2 md:gap-4 font-mono text-sm font-bold uppercase tracking-wider p-4 md:p-0 z-40 shadow-[0_4px_0_#000] md:shadow-none">
          <a href="/play" class={`px-4 py-2 transition-colors ${pathname.startsWith('/play') ? 'bg-black text-white' : 'hover:bg-black/5 text-black'}`}>Play</a>
          <a href="/duel" class={`px-4 py-2 transition-colors ${pathname.startsWith('/duel') ? 'bg-black text-white' : 'hover:bg-black/5 text-black'}`}>Duel</a>
          <a href="/leaderboard" class={`px-4 py-2 transition-colors ${pathname.startsWith('/leaderboard') ? 'bg-black text-white' : 'hover:bg-black/5 text-black'}`}>Ranks</a>
          <a href="/explore" class={`px-4 py-2 transition-colors ${pathname.startsWith('/explore') ? 'bg-black text-white' : 'hover:bg-black/5 text-black'}`}>Explore</a>
        </nav>
      </div>
    </header>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const nav = document.getElementById('main-nav');
      if (btn && nav) {
        btn.addEventListener('click', () => {
          nav.classList.toggle('hidden');
          nav.classList.toggle('flex');
        });
      }
    </script>

    <main id="main-content" class="flex-grow w-full">
      <slot />
    </main>

    <footer class="w-full border-t-4 border-black bg-black text-white mt-auto py-12">
      <div class="w-full px-6 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="text-2xl font-display font-black tracking-tighter uppercase">
          Com<span class="text-[var(--color-brand-accent)]">Pair</span>
        </div>
        <div class="text-center md:text-right font-mono text-sm text-white/70">
          <p>Don't just memorize facts.</p>
          <p>Develop an intuition for reality.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
