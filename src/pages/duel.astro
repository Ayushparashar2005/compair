---
import Layout from '../components/layout/Layout.astro';
---

<Layout title="Duel Arena | Compair" hideFooter={true}>
  <main id="duel-page" class="w-full min-h-[100dvh] bg-transparent text-black font-mono overflow-x-hidden relative py-4 sm:py-12 px-2 sm:px-4 flex flex-col items-center justify-center">
    
    <!-- LOBBY VIEW -->
    <div id="lobby-view" class="w-full max-w-3xl relative z-10 py-3 sm:py-6 flex flex-col items-center gap-4 sm:gap-8">
      
      {/* Header */}
      <div class="text-center">
        <div class="inline-block px-3 py-1 bg-black text-white font-mono text-xs uppercase font-black tracking-widest mb-3 neo-border-sm neo-shadow-sm">
          HEAD-TO-HEAD SHOWDOWN
        </div>
        <h1 class="text-3xl sm:text-5xl md:text-7xl font-display font-black uppercase tracking-tighter mb-2 sm:mb-4 [text-wrap:balance] drop-shadow-sm">
          DUEL ARENA
        </h1>
        <p class="text-base md:text-lg text-[var(--color-brand-text-secondary)] max-w-xl mx-auto font-medium">
          Real-time comparison battles. Race against friends or AI across 7 high-stakes rounds with live scoreboards, multipliers, and speed bonuses.
        </p>
      </div>

      {/* Player Handle Input */}
      <div class="w-full max-w-md neo-panel p-5 rounded-2xl flex flex-col sm:flex-row sm:items-center gap-3">
        <span class="font-mono text-[10px] sm:text-xs font-black uppercase tracking-wider text-black whitespace-nowrap">
          YOUR NAME:
        </span>
        <input 
          id="player-name-input"
          type="text" 
          maxlength="16" 
          placeholder="e.g. Ace" 
          class="w-full sm:flex-1 bg-white neo-border px-4 py-2.5 rounded-xl font-mono font-black text-sm uppercase focus:outline-none focus:neo-shadow-accent transition-all text-black"
        />
      </div>

      {/* Mobile Tabs Navigation (Visible only on <640px) */}
      <div class="flex sm:hidden w-full max-w-md neo-panel p-1.5 rounded-2xl mb-2" id="mobile-tabs">
        <button data-tab="ai" class="flex-1 py-2 text-[10px] xs:text-xs font-mono font-black uppercase tracking-wider bg-black text-white rounded-xl neo-border-sm transition-colors">
          ⚡ AI Duel
        </button>
        <button data-tab="pvp" class="flex-1 py-2 text-[10px] xs:text-xs font-mono font-black uppercase tracking-wider bg-transparent text-gray-600 rounded-xl transition-colors">
          👥 PvP
        </button>
        <button data-tab="join" class="flex-1 py-2 text-[10px] xs:text-xs font-mono font-black uppercase tracking-wider bg-transparent text-gray-600 rounded-xl transition-colors">
          🔑 Join
        </button>
      </div>

      {/* Main Container: AI Match vs Host Match (Grid on Desktop, Tabs on Mobile) */}
      <div class="w-full flex flex-col sm:grid sm:grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        
        {/* Quick AI Duel Card */}
        <div id="tab-content-ai" class="neo-panel p-5 sm:p-8 flex flex-col justify-between rounded-2xl transition-all group">
          <div>
            <div class="inline-block px-3 py-1 bg-white text-black neo-border-sm rounded-full font-mono text-[10px] font-black uppercase tracking-wider mb-3 sm:mb-4 neo-shadow-sm">
              INSTANT MATCH
            </div>
            <h3 class="text-xl sm:text-2xl font-display font-black uppercase mb-1 sm:mb-2 text-black drop-shadow-sm">VS AI BOT</h3>
            <p class="text-[10px] sm:text-xs text-gray-600 leading-relaxed font-medium mb-3 sm:mb-4">
              Test your reaction speed and intuition against simulated algorithmic bots with human-like thinking delay.
            </p>

            {/* Bot Difficulty Selector */}
            <div class="mb-4 sm:mb-6">
              <span class="text-[9px] sm:text-[10px] font-mono font-black uppercase text-gray-500 tracking-wider block mb-1.5 sm:mb-2">
                SELECT DIFFICULTY:
              </span>
              <div class="grid grid-cols-3 gap-2">
                <button type="button" data-diff="novice" class="diff-btn py-2 px-1 sm:px-2 border border-black/10 rounded-xl font-mono text-[9px] sm:text-xs font-bold uppercase transition-all bg-white hover:bg-black/5 flex flex-col items-center justify-center">
                  <span class="text-gray-700">Novice</span>
                  <span class="text-[8px] sm:text-[9px] text-gray-400 mt-0.5 whitespace-nowrap">No hesitation</span>
                </button>
                <button type="button" data-diff="pro" class="diff-btn py-2 px-1 sm:px-2 border border-transparent rounded-xl font-mono text-[9px] sm:text-xs font-bold uppercase transition-all bg-black/80 text-white shadow-sm flex flex-col items-center justify-center">
                  <span>Pro ⚡</span>
                  <span class="text-[8px] sm:text-[9px] text-white/60 mt-0.5 whitespace-nowrap">0.8s pause</span>
                </button>
                <button type="button" data-diff="master" class="diff-btn py-2 px-1 sm:px-2 border border-black/10 rounded-xl font-mono text-[9px] sm:text-xs font-bold uppercase transition-all bg-white hover:bg-black/5 flex flex-col items-center justify-center">
                  <span class="text-gray-700">Master 🔮</span>
                  <span class="text-[8px] sm:text-[9px] text-gray-400 mt-0.5 whitespace-nowrap">2s delay</span>
                </button>
              </div>
            </div>
          </div>

          <button 
            id="ai-match-btn"
            class="w-full py-3.5 sm:py-4 bg-black text-white font-black font-mono uppercase text-xs sm:text-sm tracking-widest rounded-xl neo-border neo-shadow-sm neo-btn mt-4"
          >
            START AI DUEL →
          </button>
        </div>

        {/* Host PvP Match Card */}
        <div id="tab-content-pvp" class="hidden sm:flex neo-panel p-5 sm:p-8 flex-col justify-between rounded-2xl transition-all group">
          <div>
            <div class="inline-block px-3 py-1 bg-white text-black neo-border-sm rounded-full font-mono text-[10px] font-black uppercase tracking-wider mb-3 sm:mb-4 neo-shadow-sm">
              2-PLAYER ROOM
            </div>
            <h3 class="text-xl sm:text-2xl font-display font-black uppercase mb-1 sm:mb-2 text-black drop-shadow-sm">PLAY WITH FRIEND</h3>
            <p class="text-[10px] sm:text-xs text-gray-600 leading-relaxed font-medium mb-4 sm:mb-6">
              Generate a custom 6-letter room code and link. Duel in real-time across any phone or desktop with zero sign-up.
            </p>
          </div>

          <button 
            id="create-pvp-btn"
            class="w-full py-3.5 sm:py-4 bg-[#c084fc] text-black font-black font-mono uppercase text-xs sm:text-sm tracking-widest rounded-xl neo-border neo-shadow-sm neo-btn mt-4"
          >
            CREATE PRIVATE ROOM →
          </button>
        </div>
        
        {/* Join with Code Card (Moved inside the flex container for mobile tabs, spans full width on desktop) */}
        <div id="tab-content-join" class="hidden sm:flex w-full md:col-span-2 neo-panel p-6 sm:p-8 md:p-10 rounded-2xl flex-col items-center text-center transition-all">
          <h2 class="text-xl sm:text-2xl font-display font-black uppercase tracking-tight mb-1 sm:mb-2 text-black drop-shadow-sm">
            HAVE A ROOM CODE?
          </h2>
          <p class="text-[10px] sm:text-xs font-black text-gray-700 uppercase tracking-wider mb-4 sm:mb-6">
            Enter the 6-letter room code from your friend to jump straight into the arena
          </p>
          
          <div class="flex flex-col sm:flex-row gap-2 sm:gap-3 w-full max-w-md">
            <input 
              id="code-input"
              type="text" 
              maxlength="6" 
              placeholder="ABCDEF"
              class="flex-1 bg-white neo-border rounded-xl text-black font-mono font-black text-lg sm:text-xl md:text-2xl tracking-widest text-center uppercase px-4 py-3 sm:px-5 sm:py-4 focus:outline-none focus:neo-shadow-accent transition-all"
            />
            <button 
              id="join-btn"
              class="px-8 sm:px-10 py-3 sm:py-4 bg-[var(--color-brand-accent)] text-black font-black font-mono text-sm sm:text-lg uppercase tracking-widest rounded-xl neo-border neo-shadow-sm neo-btn"
            >
              JOIN →
            </button>
          </div>
        </div>
      </div>

      <a href="/" class="inline-block mt-4 px-8 py-3.5 bg-white neo-border text-black rounded-xl font-black text-xs uppercase tracking-widest neo-btn neo-shadow-sm transition-all">
        ← Back to Solo Game
      </a>
    </div>

    <!-- JOINING VIEW -->
    <div id="joining-view" class="hidden w-full max-w-3xl relative z-10 py-6">
      <div class="neo-panel p-10 md:p-14 text-center rounded-2xl">
        <div class="text-5xl mb-4 animate-bounce">⚔️</div>
        <h2 id="joining-title" class="text-3xl font-display font-black uppercase tracking-tight mb-2 text-black drop-shadow-sm">Joining Arena Room</h2>
        <p id="joining-desc" class="font-mono text-gray-800 mb-6 font-bold">Connecting to duel code...</p>
        <div id="joining-pulse" class="inline-block px-6 py-3 bg-white text-black rounded-lg neo-border-sm font-mono text-xs uppercase font-black tracking-widest animate-pulse neo-shadow-sm">
          SYNCHRONIZING COMPARISON DECK...
        </div>
        <a id="joining-back" href="/duel" class="hidden mt-6 inline-block px-8 py-3 bg-white neo-border rounded-xl text-black font-black font-mono uppercase tracking-widest neo-btn neo-shadow-sm">
          Try Another Code →
        </a>
      </div>
    </div>

  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const joinCode = params.get('join');
    const lobbyView = document.getElementById('lobby-view')!;
    const joiningView = document.getElementById('joining-view')!;
    const joiningTitle = document.getElementById('joining-title')!;
    const joiningDesc = document.getElementById('joining-desc')!;
    const joiningPulse = document.getElementById('joining-pulse')!;
    const joiningBack = document.getElementById('joining-back')!;

    const nameInput = document.getElementById('player-name-input') as HTMLInputElement;
    if (nameInput) {
      nameInput.value = localStorage.getItem('compair_player_name') || '';
    }

    const getPlayerName = () => {
      const name = nameInput?.value.trim();
      if (name) localStorage.setItem('compair_player_name', name);
      return name || 'Player 1';
    };

    // Mobile Tabs Logic
    const tabButtons = document.querySelectorAll('#mobile-tabs button');
    const tabContents = {
      ai: document.getElementById('tab-content-ai'),
      pvp: document.getElementById('tab-content-pvp'),
      join: document.getElementById('tab-content-join')
    };

    // Initialize layout based on screen width
    const initTabs = () => {
      const isMobile = window.innerWidth < 640; // sm breakpoint
      if (isMobile) {
        // Enforce tab layout
        const activeTab = document.querySelector('#mobile-tabs button.bg-black')?.getAttribute('data-tab') || 'ai';
        Object.entries(tabContents).forEach(([id, el]) => {
          if (!el) return;
          if (id === activeTab) {
            el.classList.remove('hidden');
            el.classList.add('flex');
          } else {
            el.classList.remove('flex');
            el.classList.add('hidden');
          }
        });
      } else {
        // Enforce desktop layout (all visible)
        Object.values(tabContents).forEach(el => {
          if (!el) return;
          el.classList.remove('hidden');
          el.classList.add('flex');
        });
      }
    };

    window.addEventListener('resize', initTabs);
    initTabs(); // Run on load

    tabButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const tabId = target.getAttribute('data-tab');
        
        // Update buttons
        tabButtons.forEach(b => {
          b.className = 'flex-1 py-2 text-[10px] xs:text-xs font-mono font-black uppercase tracking-wider bg-transparent text-gray-600 rounded-xl transition-colors';
        });
        target.className = 'flex-1 py-2 text-[10px] xs:text-xs font-mono font-black uppercase tracking-wider bg-black text-white rounded-xl neo-border-sm transition-colors';

        // Update contents (only if mobile)
        if (window.innerWidth < 640) {
          Object.entries(tabContents).forEach(([id, el]) => {
            if (!el) return;
            if (id === tabId) {
              el.classList.remove('hidden');
              el.classList.add('flex');
            } else {
              el.classList.remove('flex');
              el.classList.add('hidden');
            }
          });
        }
      });
    });

    if (joinCode) {
      lobbyView.classList.add('hidden');
      joiningView.classList.remove('hidden');
      joiningDesc.innerHTML = `Connecting to duel code <strong class="text-[var(--color-brand-accent)] text-xl">${joinCode.toUpperCase()}</strong>...`;

      const storedName = localStorage.getItem('compair_player_name') || 'Challenger';

      fetch('/api/duel/join', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ inviteCode: joinCode, playerName: storedName }),
      }).then(r => r.json()).then(data => {
        if (data.error) {
          joiningTitle.innerText = "Unable to Join Duel";
          joiningTitle.classList.add('text-[var(--color-brand-incorrect)]');
          joiningDesc.innerText = data.error;
          joiningPulse.classList.add('hidden');
          joiningBack.classList.remove('hidden');
          return;
        }
        sessionStorage.setItem('duel_session_id', data.sessionId);
        sessionStorage.setItem('duel_token', data.playerBToken);
        sessionStorage.setItem('duel_seat', 'B');
        window.location.href = `/duel/${data.sessionId}`;
      }).catch(e => {
        joiningTitle.innerText = "Network Error";
        joiningTitle.classList.add('text-[var(--color-brand-incorrect)]');
        joiningDesc.innerText = e.message;
        joiningPulse.classList.add('hidden');
        joiningBack.classList.remove('hidden');
      });
    } else {
      let selectedDifficulty = 'pro';
      const diffButtons = document.querySelectorAll('.diff-btn');
      diffButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          selectedDifficulty = target.dataset.diff || 'pro';
          diffButtons.forEach(b => {
            b.className = 'diff-btn py-2 px-1 sm:px-2 border border-black/10 rounded-xl font-mono text-[9px] sm:text-xs font-bold uppercase transition-all bg-white hover:bg-black/5 flex flex-col items-center justify-center';
            b.querySelector('span:first-child')!.className = 'text-gray-700';
            b.querySelector('span:last-child')!.className = 'text-[8px] sm:text-[9px] text-gray-400 mt-0.5 whitespace-nowrap';
          });
          target.className = 'diff-btn py-2 px-1 sm:px-2 border border-transparent rounded-xl font-mono text-[9px] sm:text-xs font-bold uppercase transition-all bg-black/80 text-white shadow-sm flex flex-col items-center justify-center';
          target.querySelector('span:first-child')!.className = '';
          target.querySelector('span:last-child')!.className = 'text-[8px] sm:text-[9px] text-white/60 mt-0.5 whitespace-nowrap';
        });
      });

      const joinBtn = document.getElementById('join-btn');
      const codeInput = document.getElementById('code-input') as HTMLInputElement;

      joinBtn?.addEventListener('click', () => {
        const code = codeInput.value.trim().toUpperCase();
        if (code.length === 6) {
          getPlayerName();
          window.location.href = `/duel?join=${code}`;
        }
      });

      codeInput?.addEventListener('keyup', (e) => {
        if (e.key === 'Enter') {
          const code = codeInput.value.trim().toUpperCase();
          if (code.length === 6) {
            getPlayerName();
            window.location.href = `/duel?join=${code}`;
          }
        }
      });

      document.getElementById('ai-match-btn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'SETTING UP ARENA...';
        
        try {
          const res = await fetch('/api/duel/start', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ 
              mode: 'house',
              difficulty: selectedDifficulty,
              playerName: getPlayerName(),
              totalRounds: 7,
            }),
          });
          const data = await res.json();
          sessionStorage.setItem('duel_session_id', data.sessionId);
          sessionStorage.setItem('duel_token', data.playerAToken);
          sessionStorage.setItem('duel_seat', 'A');
          window.location.href = `/duel/${data.sessionId}`;
        } catch (err: any) {
          alert('Failed to start AI duel: ' + err.message);
          btn.disabled = false;
          btn.textContent = 'START AI DUEL →';
        }
      });

      document.getElementById('create-pvp-btn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'GENERATING ROOM...';

        try {
          const res = await fetch('/api/duel/start', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ 
              mode: 'pvp',
              playerName: getPlayerName(),
              totalRounds: 7,
            }),
          });
          const data = await res.json();
          sessionStorage.setItem('duel_session_id', data.sessionId);
          sessionStorage.setItem('duel_token', data.playerAToken);
          sessionStorage.setItem('duel_seat', 'A');
          window.location.href = `/duel/${data.sessionId}`;
        } catch (err: any) {
          alert('Failed to create room: ' + err.message);
          btn.disabled = false;
          btn.textContent = 'CREATE PRIVATE ROOM →';
        }
      });
    }
  });
</script>
