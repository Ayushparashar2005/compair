---
import Layout from '../components/layout/Layout.astro';
---

<Layout title="Duel Arena | Compair" hideFooter={true}>
  <main id="duel-page" class="w-full min-h-[100dvh] bg-transparent text-black font-mono overflow-x-hidden relative py-4 sm:py-12 px-2 sm:px-4 flex flex-col items-center justify-center">
    
    <!-- LOBBY VIEW -->
    <div id="lobby-view" class="w-full max-w-3xl relative z-10 py-6 flex flex-col items-center gap-8">
      
      {/* Header */}
      <div class="text-center">
        <div class="inline-block px-3 py-1 bg-black text-white font-mono text-xs uppercase font-black tracking-widest mb-3 shadow-[2px_2px_0_#000]">
          HEAD-TO-HEAD SHOWDOWN
        </div>
        <h1 class="text-5xl md:text-7xl font-display font-black uppercase tracking-tighter mb-4 [text-wrap:balance]">
          DUEL ARENA
        </h1>
        <p class="text-base md:text-lg text-[var(--color-brand-text-secondary)] max-w-xl mx-auto font-medium">
          Real-time comparison battles. Race against friends or AI across 7 high-stakes rounds with live scoreboards, multipliers, and speed bonuses.
        </p>
      </div>

      {/* Player Handle Input */}
      <div class="w-full max-w-md bg-white border-4 border-black p-4 shadow-[4px_4px_0_#000] flex items-center gap-3">
        <span class="font-mono text-xs font-black uppercase tracking-wider text-gray-500 whitespace-nowrap">
          YOUR NAME:
        </span>
        <input 
          id="player-name-input"
          type="text" 
          maxlength="16" 
          placeholder="e.g. Ace" 
          class="flex-1 bg-[#f4f4f0] border-2 border-black px-3 py-1.5 font-mono font-bold text-sm uppercase focus:outline-none focus:ring-2 focus:ring-[var(--color-brand-accent)]"
        />
      </div>

      {/* Main Grid: AI Match vs Host Match */}
      <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* Quick AI Duel Card */}
        <div class="bg-white border-4 border-black p-4 sm:p-6 flex flex-col justify-between shadow-[6px_6px_0_#000] hover:-translate-y-1 transition-transform">
          <div>
            <div class="inline-block px-2.5 py-1 bg-blue-100 text-blue-900 border border-black font-mono text-[10px] font-black uppercase tracking-wider mb-3">
              INSTANT MATCH
            </div>
            <h3 class="text-2xl font-display font-black uppercase mb-2">VS AI BOT</h3>
            <p class="text-xs text-gray-600 leading-relaxed font-medium mb-4">
              Test your reaction speed and intuition against simulated algorithmic bots with human-like thinking delay.
            </p>

            {/* Bot Difficulty Selector */}
            <div class="mb-6">
              <span class="text-[10px] font-mono font-black uppercase text-gray-500 tracking-wider block mb-2">
                SELECT DIFFICULTY:
              </span>
              <div class="grid grid-cols-3 gap-2">
                <button type="button" data-diff="novice" class="diff-btn py-1.5 px-2 border-2 border-black font-mono text-xs font-bold uppercase transition-all bg-white hover:bg-gray-100 group flex flex-col items-center justify-center">
                  <span>Novice</span>
                  <span class="text-[9px] text-gray-500 opacity-0 group-hover:opacity-100 transition-opacity mt-0.5">No hesitation</span>
                </button>
                <button type="button" data-diff="pro" class="diff-btn py-1.5 px-2 border-2 border-black font-mono text-xs font-bold uppercase transition-all bg-black text-white shadow-[2px_2px_0_#000] group flex flex-col items-center justify-center">
                  <span>Pro ⚡</span>
                  <span class="text-[9px] text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity mt-0.5">0.8s pause</span>
                </button>
                <button type="button" data-diff="master" class="diff-btn py-1.5 px-2 border-2 border-black font-mono text-xs font-bold uppercase transition-all bg-white hover:bg-gray-100 group flex flex-col items-center justify-center">
                  <span>Master 🔮</span>
                  <span class="text-[9px] text-gray-500 opacity-0 group-hover:opacity-100 transition-opacity mt-0.5">2s delay</span>
                </button>
              </div>
            </div>
          </div>

          <button 
            id="ai-match-btn"
            class="w-full py-4 bg-black text-white font-black font-mono uppercase text-sm tracking-widest border-2 border-black hover:bg-gray-800 transition-colors shadow-[3px_3px_0_#000]"
          >
            START AI DUEL →
          </button>
        </div>

        {/* Host PvP Match Card */}
        <div class="bg-white border-4 border-black p-4 sm:p-6 flex flex-col justify-between shadow-[6px_6px_0_#000] hover:-translate-y-1 transition-transform">
          <div>
            <div class="inline-block px-2.5 py-1 bg-purple-100 text-purple-900 border border-black font-mono text-[10px] font-black uppercase tracking-wider mb-3">
              2-PLAYER ROOM
            </div>
            <h3 class="text-2xl font-display font-black uppercase mb-2">PLAY WITH FRIEND</h3>
            <p class="text-xs text-gray-600 leading-relaxed font-medium mb-6">
              Generate a custom 6-letter room code and link. Duel in real-time across any phone or desktop with zero sign-up.
            </p>
          </div>

          <button 
            id="create-pvp-btn"
            class="w-full py-4 bg-purple-600 text-white font-black font-mono uppercase text-sm tracking-widest border-2 border-black hover:bg-purple-700 transition-colors shadow-[3px_3px_0_#000]"
          >
            CREATE PRIVATE ROOM →
          </button>
        </div>
      </div>

      {/* Join with Code Card */}
      <div class="w-full bg-white border-4 border-black p-4 sm:p-6 md:p-8 shadow-[6px_6px_0_#000] flex flex-col items-center text-center">
        <h2 class="text-2xl font-display font-black uppercase tracking-tight mb-2">
          HAVE A ROOM CODE?
        </h2>
        <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-6">
          Enter the 6-letter room code from your friend to jump straight into the arena
        </p>
        
        <div class="flex flex-col sm:flex-row gap-3 w-full max-w-md">
          <input 
            id="code-input"
            type="text" 
            maxlength="6" 
            placeholder="ABCDEF"
            class="flex-1 bg-[#f4f4f0] border-4 border-black text-black font-mono font-black text-xl sm:text-2xl tracking-wider sm:tracking-widest text-center uppercase px-4 py-3 focus:outline-none focus:ring-4 focus:ring-[var(--color-brand-accent)] shadow-[3px_3px_0_#000]"
          />
          <button 
            id="join-btn"
            class="px-8 py-3 bg-[var(--color-brand-accent)] text-white font-black font-mono text-lg uppercase tracking-widest border-4 border-black shadow-[3px_3px_0_#000] hover:-translate-y-0.5 active:translate-y-0 transition-all"
          >
            JOIN →
          </button>
        </div>
      </div>

      <a href="/" class="inline-block px-6 py-2.5 bg-white border-2 border-black font-bold text-xs uppercase tracking-widest hover:bg-gray-100 transition-colors shadow-[2px_2px_0_#000]">
        ← Back to Solo Game
      </a>
    </div>

    <!-- JOINING VIEW -->
    <div id="joining-view" class="hidden w-full max-w-3xl relative z-10 py-6">
      <div class="bg-white border-4 border-black p-8 md:p-12 text-center shadow-[8px_8px_0_#000]">
        <div class="text-5xl mb-4 animate-bounce">⚔️</div>
        <h2 id="joining-title" class="text-3xl font-display font-black uppercase tracking-tight mb-2">Joining Arena Room</h2>
        <p id="joining-desc" class="font-mono text-gray-600 mb-6">Connecting to duel code...</p>
        <div id="joining-pulse" class="inline-block px-5 py-2.5 bg-black text-white font-mono text-xs uppercase font-bold tracking-widest animate-pulse">
          SYNCHRONIZING COMPARISON DECK...
        </div>
        <a id="joining-back" href="/duel" class="hidden mt-6 inline-block px-8 py-3 bg-black text-white font-bold font-mono uppercase tracking-widest border-2 border-black hover:bg-gray-800 transition-colors">
          Try Another Code →
        </a>
      </div>
    </div>

  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const joinCode = params.get('join');
    const lobbyView = document.getElementById('lobby-view')!;
    const joiningView = document.getElementById('joining-view')!;
    const joiningTitle = document.getElementById('joining-title')!;
    const joiningDesc = document.getElementById('joining-desc')!;
    const joiningPulse = document.getElementById('joining-pulse')!;
    const joiningBack = document.getElementById('joining-back')!;

    const nameInput = document.getElementById('player-name-input') as HTMLInputElement;
    if (nameInput) {
      nameInput.value = localStorage.getItem('compair_player_name') || '';
    }

    const getPlayerName = () => {
      const name = nameInput?.value.trim();
      if (name) localStorage.setItem('compair_player_name', name);
      return name || 'Player 1';
    };

    if (joinCode) {
      lobbyView.classList.add('hidden');
      joiningView.classList.remove('hidden');
      joiningDesc.innerHTML = `Connecting to duel code <strong class="text-[var(--color-brand-accent)] text-xl">${joinCode.toUpperCase()}</strong>...`;

      const storedName = localStorage.getItem('compair_player_name') || 'Challenger';

      fetch('/api/duel/join', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ inviteCode: joinCode, playerName: storedName }),
      }).then(r => r.json()).then(data => {
        if (data.error) {
          joiningTitle.innerText = "Unable to Join Duel";
          joiningTitle.classList.add('text-[var(--color-brand-incorrect)]');
          joiningDesc.innerText = data.error;
          joiningPulse.classList.add('hidden');
          joiningBack.classList.remove('hidden');
          return;
        }
        sessionStorage.setItem('duel_session_id', data.sessionId);
        sessionStorage.setItem('duel_token', data.playerBToken);
        sessionStorage.setItem('duel_seat', 'B');
        window.location.href = `/duel/${data.sessionId}`;
      }).catch(e => {
        joiningTitle.innerText = "Network Error";
        joiningTitle.classList.add('text-[var(--color-brand-incorrect)]');
        joiningDesc.innerText = e.message;
        joiningPulse.classList.add('hidden');
        joiningBack.classList.remove('hidden');
      });
    } else {
      let selectedDifficulty = 'pro';
      const diffButtons = document.querySelectorAll('.diff-btn');
      diffButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          selectedDifficulty = target.dataset.diff || 'pro';
          diffButtons.forEach(b => {
            b.className = 'diff-btn py-1.5 px-2 border-2 border-black font-mono text-xs font-bold uppercase transition-all bg-white hover:bg-gray-100 group flex flex-col items-center justify-center';
          });
          target.className = 'diff-btn py-1.5 px-2 border-2 border-black font-mono text-xs font-bold uppercase transition-all bg-black text-white shadow-[2px_2px_0_#000] group flex flex-col items-center justify-center';
        });
      });

      const joinBtn = document.getElementById('join-btn');
      const codeInput = document.getElementById('code-input') as HTMLInputElement;

      joinBtn?.addEventListener('click', () => {
        const code = codeInput.value.trim().toUpperCase();
        if (code.length === 6) {
          getPlayerName();
          window.location.href = `/duel?join=${code}`;
        }
      });

      codeInput?.addEventListener('keyup', (e) => {
        if (e.key === 'Enter') {
          const code = codeInput.value.trim().toUpperCase();
          if (code.length === 6) {
            getPlayerName();
            window.location.href = `/duel?join=${code}`;
          }
        }
      });

      document.getElementById('ai-match-btn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'SETTING UP ARENA...';
        
        try {
          const res = await fetch('/api/duel/start', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ 
              mode: 'house',
              difficulty: selectedDifficulty,
              playerName: getPlayerName(),
              totalRounds: 7,
            }),
          });
          const data = await res.json();
          sessionStorage.setItem('duel_session_id', data.sessionId);
          sessionStorage.setItem('duel_token', data.playerAToken);
          sessionStorage.setItem('duel_seat', 'A');
          window.location.href = `/duel/${data.sessionId}`;
        } catch (err: any) {
          alert('Failed to start AI duel: ' + err.message);
          btn.disabled = false;
          btn.textContent = 'START AI DUEL →';
        }
      });

      document.getElementById('create-pvp-btn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'GENERATING ROOM...';

        try {
          const res = await fetch('/api/duel/start', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ 
              mode: 'pvp',
              playerName: getPlayerName(),
              totalRounds: 7,
            }),
          });
          const data = await res.json();
          sessionStorage.setItem('duel_session_id', data.sessionId);
          sessionStorage.setItem('duel_token', data.playerAToken);
          sessionStorage.setItem('duel_seat', 'A');
          window.location.href = `/duel/${data.sessionId}`;
        } catch (err: any) {
          alert('Failed to create room: ' + err.message);
          btn.disabled = false;
          btn.textContent = 'CREATE PRIVATE ROOM →';
        }
      });
    }
  });
</script>
