---
import Layout from '../../components/layout/Layout.astro';
import { DuelMatchView } from '../../components/duel/DuelMatchView';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/duel');
}

export const prerender = false;
---

<Layout title={`Duel #${id} | Compair`} hideFooter={true}>
  <main class="w-full min-h-[100dvh] bg-transparent text-black font-mono overflow-x-hidden relative py-4 sm:py-12 px-2 sm:px-4 flex flex-col items-center justify-center">
    <div class="absolute inset-0 grid-bg opacity-30 pointer-events-none"></div>
    <div class="w-full max-w-4xl relative z-10">
      <DuelMatchView client:only="react" sessionId={id} />
    </div>
  </main>
</Layout>

<style>
  .grid-bg {
    background-size: 40px 40px;
    background-image: 
      linear-gradient(to right, rgba(0,0,0,0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0,0,0,0.05) 1px, transparent 1px);
  }
</style>
