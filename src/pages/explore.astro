---
import Layout from '../components/layout/Layout.astro';
import { ExploreFilters } from '../components/explore/ExploreFilters';
import { db } from '../lib/db';
import { entities } from '../lib/db/schema/entities';
import { categories } from '../lib/db/schema/categories';
import { eq } from 'drizzle-orm';

let allEntities: any[] = [];
let allCategories: any[] = [];
let dbError = false;

try {
  allEntities = await db
    .select({
      id: entities.id,
      name: entities.name,
      slug: entities.slug,
      emoji: entities.emoji,
      categoryName: categories.name,
      categoryColor: categories.color,
    })
    .from(entities)
    .innerJoin(categories, eq(entities.categoryId, categories.id))
    .orderBy(entities.name)
    .limit(48);

  allCategories = await db.select().from(categories).orderBy(categories.name);
} catch (e) {
  console.error('[explore.astro] Failed to load entities or categories:', e);
  dbError = true;
}
---

<Layout title="Explore">
  <div class="max-w-6xl mx-auto px-6 py-6 md:py-16">
    <div class="border-b border-black/10 mb-6 md:mb-12 pb-4 md:pb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <h1 class="text-3xl sm:text-5xl md:text-7xl font-display font-black uppercase tracking-tighter text-black drop-shadow-sm">
          Explore the World
        </h1>
        <p class="font-mono text-lg mt-4 max-w-xl text-gray-800 font-bold">
          Browse all entities and discover interesting statistics.
        </p>
      </div>
      <div class="inline-block px-4 py-2 bg-white text-black font-mono text-xs font-black uppercase tracking-widest neo-shadow-sm neo-border rounded-xl">
        <span class="text-[var(--color-brand-accent)]">{allEntities.length}</span> Entities across <span class="text-[var(--color-brand-accent)]">{allCategories.length}</span> Categories
      </div>
    </div>

    {dbError && (
      <div class="bg-[#fcd34d] p-4 mb-8 neo-shadow-sm rounded-2xl neo-border text-black font-mono text-xs font-black uppercase tracking-widest">
        ⚠️ Unable to sync live catalog. Displaying cached explorer view.
      </div>
    )}

    <ExploreFilters 
      client:load 
      initialEntities={allEntities} 
      categories={allCategories} 
    />
  </div>
</Layout>
