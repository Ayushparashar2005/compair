---
import Layout from '../components/layout/Layout.astro';
import { ExploreFilters } from '../components/explore/ExploreFilters';
import { db } from '../lib/db';
import { entities } from '../lib/db/schema/entities';
import { categories } from '../lib/db/schema/categories';
import { eq } from 'drizzle-orm';

let allEntities: any[] = [];
let allCategories: any[] = [];
let dbError = false;

try {
  allEntities = await db
    .select({
      id: entities.id,
      name: entities.name,
      slug: entities.slug,
      emoji: entities.emoji,
      categoryName: categories.name,
      categoryColor: categories.color,
    })
    .from(entities)
    .innerJoin(categories, eq(entities.categoryId, categories.id))
    .orderBy(entities.name)
    .limit(48);

  allCategories = await db.select().from(categories).orderBy(categories.name);
} catch (e) {
  console.error('[explore.astro] Failed to load entities or categories:', e);
  dbError = true;
}
---

<Layout title="Explore">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="border-b-4 border-black mb-12 pb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <h1 class="text-5xl md:text-7xl font-display font-black uppercase tracking-tighter">
          Explore the World
        </h1>
        <p class="font-mono text-lg mt-4 max-w-xl text-[var(--color-brand-text-secondary)]">
          Browse all entities and discover interesting statistics.
        </p>
      </div>
      <div class="inline-block px-4 py-2 bg-black text-white font-mono text-xs font-bold uppercase tracking-widest shadow-[4px_4px_0_var(--color-brand-accent)] border-2 border-transparent">
        <span class="text-[var(--color-brand-accent)]">{allEntities.length}</span> Entities across <span class="text-[var(--color-brand-accent)]">{allCategories.length}</span> Categories
      </div>
    </div>

    {dbError && (
      <div class="bg-amber-100 border-4 border-black p-4 mb-8 shadow-[4px_4px_0_#000] font-mono text-xs font-bold text-amber-900">
        ⚠️ Unable to sync live catalog. Displaying cached explorer view.
      </div>
    )}

    <ExploreFilters 
      client:load 
      initialEntities={allEntities} 
      categories={allCategories} 
    />
  </div>
</Layout>
