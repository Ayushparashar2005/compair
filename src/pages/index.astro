---
import Layout from '../components/layout/Layout.astro';
import { GameBoard } from '../components/game/GameBoard';
import { db } from '../lib/db';
import { sql } from 'drizzle-orm';

let totalPlays = "12,483";
try {
  const result = await db.execute(sql`SELECT COUNT(*) as count FROM game_sessions`);
  if (result.rows && result.rows.length > 0 && Number(result.rows[0].count) > 0) {
    totalPlays = Number(result.rows[0].count).toLocaleString();
  }
} catch (e) {
  // ignore
}
---

<Layout title="Home" hideFooter={true}>
  <div class="flex-grow flex flex-col relative w-full items-center justify-center min-h-[calc(100vh-6rem)]">
    
    <!-- Hero Background Effects -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10 flex items-center justify-center">
      <div class="w-[80vw] h-[80vw] max-w-[800px] max-h-[800px] bg-[var(--color-brand-accent)]/10 blur-[100px] rounded-full animate-pulse"></div>
      <div class="absolute top-1/4 right-1/4 w-[40vw] h-[40vw] bg-indigo-500/10 blur-[120px] rounded-full"></div>
    </div>

    <!-- Top Section: Typography & Proposition -->
    <div class="w-full max-w-6xl px-6 md:px-12 py-12 md:py-20 flex flex-col relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center w-full">
        
        <div class="flex flex-col items-start text-left animate-slide-in-up">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md neo-border bg-white neo-shadow-sm text-[10px] sm:text-xs font-mono font-bold tracking-widest mb-8 text-black uppercase">
            <span class="w-2 h-2 rounded-full bg-[var(--color-brand-accent)] animate-pulse border border-black"></span>
            KNOWLEDGE COMPARISON ENGINE
          </div>
          
          <h1 class="text-[clamp(2.5rem,7vw,4.5rem)] font-display font-black mb-6 tracking-tight leading-[1.05] [text-wrap:balance] text-black drop-shadow-sm">
            How well do you <br class="hidden sm:block"/>
            <span class="relative inline-block px-2">
              <span class="relative z-10 text-white">understand</span>
              <span class="absolute inset-0 bg-[var(--color-brand-accent)] neo-border -z-0 rotate-1"></span>
            </span> 
            the world?
          </h1>
          
          <p class="text-base md:text-lg text-gray-800 font-mono font-medium max-w-lg mb-10 leading-relaxed">
            Real facts. Real numbers. One guess. Build an intuition for reality, not just memorized trivia.
          </p>
          
          <div class="flex flex-col gap-4 w-full sm:w-auto">
            <a href="/play" class="group relative w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-[var(--color-brand-accent)] neo-border neo-shadow text-black font-display font-black uppercase tracking-widest text-lg sm:text-xl rounded-xl neo-btn">
              <span class="relative z-10 flex items-center gap-2">Start Game <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-[3] stroke-linecap="square" stroke-linejoin="miter" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
            </a>
            
            <div class="flex flex-col sm:flex-row flex-wrap gap-3 mt-4 w-full sm:w-auto">
              <a href="/duel" class="w-full sm:w-auto text-center font-mono text-sm font-bold uppercase tracking-wider px-5 py-2.5 rounded-full neo-border bg-white text-black neo-btn hover:neo-shadow-accent flex items-center justify-center gap-2">
                <span>⚔️</span> Duel Mode
              </a>
              <a href="/explore" class="w-full sm:w-auto text-center font-mono text-sm font-bold uppercase tracking-wider px-5 py-2.5 rounded-full neo-border bg-white text-black neo-btn hover:neo-shadow-accent">
                Explore Data
              </a>
              <a href="/leaderboard" class="w-full sm:w-auto text-center font-mono text-sm font-bold uppercase tracking-wider px-5 py-2.5 rounded-full neo-border bg-white text-black neo-btn hover:neo-shadow-accent">
                Rankings
              </a>
            </div>
          </div>
        </div>
        
        {/* Abstract illustration / Live preview card */}
        <div class="hidden lg:flex lg:justify-end justify-center relative w-full pr-0 mt-8 lg:mt-0">
          <div class="w-full max-w-sm neo-panel p-6 flex flex-col items-center rounded-2xl rotate-2 hover:rotate-0 transition-transform duration-700 translate-x-0 lg:translate-x-8 group">
            <div class="w-full flex justify-between items-center mb-6 border-b-2 border-black pb-3">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-red-500 border-2 border-black"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500 border-2 border-black"></div>
                <div class="w-3 h-3 rounded-full bg-green-500 border-2 border-black"></div>
              </div>
              <div class="text-[10px] font-mono text-black font-black tracking-widest uppercase bg-black/5 px-2 py-0.5 rounded-sm neo-border-sm">Preview</div>
            </div>
            
            <h3 class="font-display font-black text-xl uppercase tracking-widest text-center mb-8 text-black">
              WHICH WEIGHS MORE?
            </h3>
            
            <div class="flex gap-4 w-full mb-6">
              <div class="flex-1 rounded-xl bg-white neo-border neo-shadow-sm aspect-square flex flex-col items-center justify-center p-3 neo-btn">
                <div class="text-4xl mb-3 drop-shadow-sm transition-transform group-hover:scale-110">🐘</div>
                <div class="text-[10px] font-black font-mono text-center text-black tracking-tighter">AFRICAN ELEPHANT</div>
              </div>
              <div class="flex-1 rounded-xl bg-white neo-border neo-shadow-sm aspect-square flex flex-col items-center justify-center p-3 neo-btn">
                <div class="text-4xl mb-3 drop-shadow-sm transition-transform group-hover:scale-110">🚗</div>
                <div class="text-[10px] font-black font-mono text-center text-black tracking-tighter">TOYOTA COROLLA</div>
              </div>
            </div>
            
            <div class="w-full mt-2 pt-4 border-t-2 border-black border-dashed flex justify-between items-center font-mono text-[10px] font-black text-black">
              <span class="bg-black text-white px-2 py-0.5">6,000 KG</span>
              <span class="text-[var(--color-brand-accent)] text-lg">VS</span>
              <span class="bg-black text-white px-2 py-0.5">1,300 KG</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Categories quick links -->
    <div class="w-full max-w-6xl mx-auto px-6 pb-12 mt-4 lg:-mt-4">
      <div class="flex items-center gap-3 md:gap-4 overflow-x-auto whitespace-nowrap hide-scrollbar flex-nowrap py-2 [mask-image:linear-gradient(to_right,black_80%,transparent_100%)]">
        <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-black mr-2 flex-shrink-0">Jump To:</span>
        <a href="/play?category=zoology" class="px-4 py-2 rounded-lg neo-border bg-white font-mono text-xs font-bold uppercase neo-btn hover:neo-shadow-sm text-black">🐘 Zoology</a>
        <a href="/play?category=astronomy" class="px-4 py-2 rounded-lg neo-border bg-white font-mono text-xs font-bold uppercase neo-btn hover:neo-shadow-sm text-black">🪐 Astronomy</a>
        <a href="/play?category=geography" class="px-4 py-2 rounded-lg neo-border bg-white font-mono text-xs font-bold uppercase neo-btn hover:neo-shadow-sm text-black">🏔️ Geography</a>
        <a href="/play?category=history" class="px-4 py-2 rounded-lg neo-border bg-white font-mono text-xs font-bold uppercase neo-btn hover:neo-shadow-sm text-black">🏛️ History</a>
        <a href="/play?category=human-body" class="px-4 py-2 rounded-lg neo-border bg-white font-mono text-xs font-bold uppercase neo-btn hover:neo-shadow-sm text-black">🧠 Human Body</a>
        <a href="/play?category=botany" class="px-4 py-2 rounded-lg neo-border bg-white font-mono text-xs font-bold uppercase neo-btn hover:neo-shadow-sm text-black">🌲 Botany</a>
      </div>
    </div>

    <!-- Bottom Section: Game Board Applet (If needed on home page, optional for new design) -->
    <!-- Leaving intact for functionality but wrapping nicely -->
    <div class="w-full max-w-5xl mx-auto flex items-center justify-center p-4 relative mb-12">
      <div class="w-full relative z-20">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/5 to-transparent blur-3xl -z-10 rounded-full"></div>
        <GameBoard client:only="react" />
      </div>
    </div>
    
  </div>
</Layout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
