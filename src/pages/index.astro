---
import Layout from '../components/layout/Layout.astro';
import { GameBoard } from '../components/game/GameBoard';
import { db } from '../lib/db';
import { sql } from 'drizzle-orm';

// Fetch a quick stat for the ticker
let totalPlays = "12,483";
try {
  const result = await db.execute(sql`SELECT COUNT(*) as count FROM game_sessions`);
  if (result.rows && result.rows.length > 0 && Number(result.rows[0].count) > 0) {
    totalPlays = Number(result.rows[0].count).toLocaleString();
  }
} catch (e) {
  // ignore
}
---

<Layout title="Home" hideFooter={true}>
  <div class="min-h-[100dvh] flex flex-col border-b-4 border-black bg-transparent">
    
    <!-- Top Section: Typography & Proposition -->
    <div class="w-full flex flex-col px-6 md:px-12 py-5 lg:py-24 border-b-4 border-black relative overflow-hidden bg-[var(--color-brand-surface)]">
      <div class="relative z-10 w-full max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-12 items-center">
        
        <div class="flex flex-col items-start text-left">
          <div class="inline-block px-3 py-1 bg-black text-white text-[10px] sm:text-xs font-mono font-bold uppercase tracking-widest mb-6">
            KNOWLEDGE COMPARISON ENGINE
          </div>
          <h1 class="text-3xl xs:text-4xl sm:text-5xl md:text-6xl lg:text-5xl xl:text-6xl font-display font-black mb-6 md:mb-8 tracking-tighter leading-[1.1] uppercase [text-wrap:balance]">
            How well do you <br class="hidden sm:block"/>
            <span class="text-white relative inline-block my-2 -skew-y-2 px-2">
              <span class="absolute inset-0 bg-black -z-10"></span>
              understand
            </span> 
            the world?
          </h1>
          
          <p class="text-lg md:text-xl text-black font-mono font-medium max-w-lg mb-10 leading-relaxed">
            Real facts. Real numbers. One guess. Build an intuition for reality, not just memorized trivia.
          </p>
          
          <div class="flex flex-col gap-4 w-full sm:w-auto">
            <a href="/play" class="w-full sm:w-auto inline-flex items-center justify-center px-6 sm:px-10 py-4 sm:py-5 bg-[var(--color-brand-accent)] text-white font-mono font-black text-base sm:text-xl tracking-widest border-4 border-black shadow-[6px_6px_0_#000] hover:-translate-y-1 hover:shadow-[8px_8px_0_#000] active:translate-y-0 active:shadow-[0px_0px_0_#000] transition-all duration-150 uppercase">
              Start Game →
            </a>
            
            <div class="flex flex-wrap gap-2 mt-1 sm:gap-4 sm:mt-2">
              <a href="/duel" class="font-mono text-sm font-bold uppercase border-2 border-black bg-white px-4 py-2 hover:bg-black hover:text-white transition-colors">
                ⚔️ Duel Mode
              </a>
              <a href="/explore" class="font-mono text-sm font-bold uppercase border-2 border-black bg-white px-4 py-2 hover:bg-black hover:text-white transition-colors">
                Explore Data
              </a>
              <a href="/leaderboard" class="font-mono text-sm font-bold uppercase border-2 border-black bg-white px-4 py-2 hover:bg-black hover:text-white transition-colors">
                Rankings
              </a>
            </div>
          </div>
        </div>
        
        {/* Abstract illustration / Live preview card */}
        <div class="hidden lg:flex lg:justify-end justify-center relative w-full pr-0 lg:pr-8 mt-8 lg:mt-0 opacity-90 lg:opacity-100 scale-90 lg:scale-100">
          <div class="w-full max-w-sm bg-white border-4 border-black shadow-[12px_12px_0_#000] p-6 flex flex-col items-center rotate-3 hover:rotate-0 transition-transform duration-500 translate-x-0 lg:translate-x-8">
            <div class="w-full flex justify-between items-center mb-6 border-b-2 border-black pb-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="text-xs font-mono font-bold tracking-widest uppercase">Sample Question</div>
              <div class="w-3 h-3"></div>
            </div>
            
            <h3 class="font-display font-black text-2xl uppercase tracking-tighter text-center mb-6 animate-pulse">
              WHICH WEIGHS MORE?
            </h3>
            
            <div class="flex gap-4 w-full mb-4">
              <div class="flex-1 bg-gray-100 border-2 border-black aspect-square flex flex-col items-center justify-center p-2">
                <div class="text-4xl mb-2">🐘</div>
                <div class="text-xs font-bold font-mono text-center">AFRICAN ELEPHANT</div>
              </div>
              <div class="flex-1 bg-gray-100 border-2 border-black aspect-square flex flex-col items-center justify-center p-2">
                <div class="text-4xl mb-2">🚗</div>
                <div class="text-xs font-bold font-mono text-center">TOYOTA COROLLA</div>
              </div>
            </div>
            
            <div class="w-full mt-2 pt-4 border-t-2 border-black border-dashed flex justify-between items-center opacity-50 font-mono text-xs font-bold">
              <span>6,000 KG</span>
              <span>VS</span>
              <span>1,300 KG</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Categories quick links -->
    <div class="w-full bg-white border-b-4 border-black overflow-hidden relative z-20">
      <div class="flex items-center gap-3 md:gap-4 px-6 py-4 overflow-x-auto whitespace-nowrap hide-scrollbar flex-nowrap">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-gray-500 mr-2 flex-shrink-0">Quick Jump:</span>
        <a href="/play?category=zoology" class="px-4 py-1.5 border-2 border-black font-mono text-sm font-bold uppercase hover:bg-[oklch(85%_0.15_145)] hover:text-black transition-colors">🐘 Zoology</a>
        <a href="/play?category=astronomy" class="px-4 py-1.5 border-2 border-black font-mono text-sm font-bold uppercase hover:bg-[oklch(85%_0.15_285)] hover:text-black transition-colors">🪐 Astronomy</a>
        <a href="/play?category=geography" class="px-4 py-1.5 border-2 border-black font-mono text-sm font-bold uppercase hover:bg-[oklch(85%_0.15_200)] hover:text-black transition-colors">🏔️ Geography</a>
        <a href="/play?category=history" class="px-4 py-1.5 border-2 border-black font-mono text-sm font-bold uppercase hover:bg-[oklch(85%_0.15_45)] hover:text-black transition-colors">🏛️ History</a>
        <a href="/play?category=human-body" class="px-4 py-1.5 border-2 border-black font-mono text-sm font-bold uppercase hover:bg-[oklch(85%_0.15_345)] hover:text-black transition-colors">🧠 Human Body</a>
        <a href="/play?category=botany" class="px-4 py-1.5 border-2 border-black font-mono text-sm font-bold uppercase hover:bg-[oklch(85%_0.15_110)] hover:text-black transition-colors">🌲 Botany</a>
      </div>
    </div>

    <!-- Bottom Section: Game Board Applet -->
    <div class="w-full flex items-center justify-center p-2 md:p-8 lg:p-16 relative">
      <div class="w-full max-w-4xl">
        <GameBoard client:only="react" />
      </div>
    </div>
    
  </div>

  <!-- Decorative ticker -->
  <div class="hidden sm:flex w-full overflow-hidden bg-black text-white font-mono text-sm py-4 border-b-4 border-black relative z-10">
    <div class="flex whitespace-nowrap animate-[scroll_20s_linear_infinite]">
      <div class="flex items-center gap-12 px-6">
        <span class="flex items-center gap-2"><div class="w-2 h-2 bg-white rounded-full animate-pulse"></div> {totalPlays} games played</span>
        <span>•</span>
        <span>Build intuition</span>
        <span>•</span>
        <span>Not just trivia</span>
        <span>•</span>
      </div>
    </div>
    <div class="flex whitespace-nowrap animate-[scroll_20s_linear_infinite]" aria-hidden="true">
      <div class="flex items-center gap-12 px-6">
        <span class="flex items-center gap-2"><div class="w-2 h-2 bg-white rounded-full animate-pulse"></div> {totalPlays} games played</span>
        <span>•</span>
        <span>Build intuition</span>
        <span>•</span>
        <span>Not just trivia</span>
        <span>•</span>
      </div>
    </div>
    <div class="flex whitespace-nowrap animate-[scroll_20s_linear_infinite]" aria-hidden="true">
      <div class="flex items-center gap-12 px-6">
        <span class="flex items-center gap-2"><div class="w-2 h-2 bg-white rounded-full animate-pulse"></div> {totalPlays} games played</span>
        <span>•</span>
        <span>Build intuition</span>
        <span>•</span>
        <span>Not just trivia</span>
        <span>•</span>
      </div>
    </div>
    <div class="flex whitespace-nowrap animate-[scroll_20s_linear_infinite]" aria-hidden="true">
      <div class="flex items-center gap-12 px-6">
        <span class="flex items-center gap-2"><div class="w-2 h-2 bg-white rounded-full animate-pulse"></div> {totalPlays} games played</span>
        <span>•</span>
        <span>Build intuition</span>
        <span>•</span>
        <span>Not just trivia</span>
        <span>•</span>
      </div>
    </div>
  </div>
</Layout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
