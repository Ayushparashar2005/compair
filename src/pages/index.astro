---
import Layout from '../components/layout/Layout.astro';
import { GameBoard } from '../components/game/GameBoard';
---

<Layout title="Home">
  <div class="min-h-[100dvh] pt-16 flex flex-col border-b-4 border-black bg-[#ececec]">
    
    <!-- Top Section: Typography & Proposition -->
    <div class="w-full flex flex-col items-center text-center px-6 md:px-12 py-16 lg:py-24 border-b-4 border-black relative overflow-hidden bg-[var(--background)]">
      <!-- Decorative grid background for brutalist vibe -->
      <div class="absolute inset-0 pointer-events-none opacity-[0.03]" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
      
      <div class="relative z-10 w-full max-w-4xl mx-auto flex flex-col items-center">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-black mb-8 tracking-tighter leading-[1.05] uppercase [text-wrap:balance]">
          How well do you <br/>
          <span class="text-white relative inline-block mx-2 my-2 lg:my-0">
            <span class="absolute inset-0 bg-black -skew-y-2 transform -z-10 scale-105"></span>
            understand
          </span> 
          the world?
        </h1>
        
        <p class="text-lg md:text-xl text-black font-mono font-medium max-w-2xl mb-12 leading-relaxed">
          Real facts. Real numbers. One guess. Build an intuition for reality, not just memorized trivia.
        </p>
        
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/play" class="inline-flex items-center justify-center px-8 py-4 bg-[var(--color-brand-accent)] text-white font-mono font-bold text-lg border-4 border-black shadow-[6px_6px_0_#000] hover:-translate-y-1 hover:shadow-[8px_8px_0_#000] active:translate-y-0 active:shadow-[0px_0px_0_#000] transition-all duration-150">
            START GAME
          </a>
          <a href="/duel" class="inline-flex items-center justify-center px-8 py-4 bg-purple-600 text-white font-mono font-bold text-lg border-4 border-black shadow-[6px_6px_0_#000] hover:-translate-y-1 hover:shadow-[8px_8px_0_#000] active:translate-y-0 active:shadow-[0px_0px_0_#000] transition-all duration-150">
            ⚔️ DUEL ARENA
          </a>
          <a href="/explore" class="inline-flex items-center justify-center px-8 py-4 bg-white text-black font-mono font-bold text-lg border-4 border-black shadow-[6px_6px_0_#000] hover:-translate-y-1 hover:shadow-[8px_8px_0_#000] active:translate-y-0 active:shadow-[0px_0px_0_#000] transition-all duration-150">
            EXPLORE DATA
          </a>
          <a href="/leaderboard" class="inline-flex items-center justify-center px-8 py-4 bg-black text-white font-mono font-bold text-lg border-4 border-black shadow-[6px_6px_0_#000] hover:-translate-y-1 hover:shadow-[8px_8px_0_#000] active:translate-y-0 active:shadow-[0px_0px_0_#000] transition-all duration-150">
            LEADERBOARD
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Section: Game Board Applet -->
    <div class="w-full flex items-center justify-center p-4 md:p-8 lg:p-16 relative">
      <div class="w-full max-w-4xl">
        <GameBoard client:only="react" />
      </div>
    </div>
    
  </div>

  <!-- Decorative ticker -->
  <div class="w-full overflow-hidden bg-black text-white font-mono text-sm py-4 border-b-4 border-black relative z-10">
    <div class="flex whitespace-nowrap animate-[scroll_20s_linear_infinite]">
      <div class="flex items-center gap-12 px-6">
        <span class="flex items-center gap-2"><div class="w-2 h-2 bg-white rounded-full animate-pulse"></div> 12,483 comparisons made today</span>
        <span>•</span>
        <span>Highest streak: 42</span>
        <span>•</span>
        <span>Most missed: GDP of Tuvalu</span>
        <span>•</span>
        <span class="flex items-center gap-2"><div class="w-2 h-2 bg-white rounded-full animate-pulse"></div> 12,483 comparisons made today</span>
        <span>•</span>
        <span>Highest streak: 42</span>
        <span>•</span>
        <span>Most missed: GDP of Tuvalu</span>
        <span>•</span>
      </div>
    </div>
  </div>
</Layout>
