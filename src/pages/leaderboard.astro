---
import Layout from '../components/layout/Layout.astro';
import { db } from '../lib/db';
import { gameSessions } from '../lib/db/schema/game_sessions';
import { users } from '../lib/db/schema/users';
import { desc, eq, gt } from 'drizzle-orm';

// Fetch top compair game runs
let topRuns: any[] = [];
try {
  topRuns = await db
    .select({
      id: gameSessions.id,
      score: gameSessions.score,
      questionsAnswered: gameSessions.questionsAnswered,
      correctAnswers: gameSessions.correctAnswers,
      startedAt: gameSessions.startedAt,
      username: users.username,
      displayName: users.displayName,
    })
    .from(gameSessions)
    .leftJoin(users, eq(gameSessions.userId, users.id))
    .where(gt(gameSessions.score, 0))
    .orderBy(desc(gameSessions.score))
    .limit(10);
} catch (e) {
  // Fallback if db is cold or table empty
  topRuns = [];
}

// Built-in AI Strategy Duel Bots & Lore
const duelBots = [
  {
    name: 'Master AI',
    tier: 'Hard (2s delay)',
    elo: 2400,
    style: 'Flawless Logic',
    winRate: '92%',
    description: 'The ultimate algorithmic opponent. Deliberates for exactly 2 seconds before answering with near-perfect accuracy.',
    avatar: '🔮',
  },
  {
    name: 'Pro Bot',
    tier: 'Medium (0.8s delay)',
    elo: 1650,
    style: 'Human-like Pacing',
    winRate: '54%',
    description: 'Simulates a skilled human player. Fast reflexes but occasionally gets tricked by counter-intuitive facts.',
    avatar: '⚡',
  },
  {
    name: 'Novice Script',
    tier: 'Easy (Instant)',
    elo: 850,
    style: 'No Hesitation',
    winRate: '12%',
    description: 'A basic script that answers instantly but makes frequent random guesses. Good for warming up.',
    avatar: '🤖',
  },
];
---

<Layout title="Leaderboard & Arenas | Compair">
  <main class="w-full min-h-screen bg-[#f4f4f0] text-black font-mono overflow-x-hidden relative py-6 md:py-12 px-4">
    <div class="absolute inset-0 grid-bg opacity-30 pointer-events-none" />

    <div class="max-w-4xl mx-auto relative z-10">
      <header class="mb-6 pb-4 md:mb-12 text-center md:text-left border-b-4 border-black md:pb-8">
        <div class="inline-block px-4 py-1 bg-black text-white text-sm font-bold uppercase tracking-widest mb-4">
          Rankings & Arenas
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-display font-black tracking-tighter uppercase mb-2 sm:mb-4 [text-wrap:balance]">
          Leaderboard
        </h1>
        <p class="text-base sm:text-lg text-[var(--color-brand-text-secondary)] max-w-2xl">
          Top runs in Compair speed comparison, plus the Strategy Duel AI champions that appear during Bonus Rounds.
        </p>
      </header>

      {/* SECTION 1: TOP COMPAIR RUNS */}
      <section class="mb-16">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-display font-black uppercase tracking-wider">
            🏆 Top High Scores
          </h2>
          <span class="text-xs text-gray-500 font-bold uppercase">All-time best</span>
        </div>

        {topRuns.length > 0 ? (
          <div class="flex flex-col gap-4">
            {topRuns.map((run, i) => {
              const accuracy = run.questionsAnswered > 0 ? Math.round((run.correctAnswers / run.questionsAnswered) * 100) : 0;
              const isTop = i === 0;

              return (
                <div class="bg-white border-4 border-black p-3 sm:p-4 md:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-[4px_4px_0_#000] hover:-translate-y-0.5 hover:shadow-[6px_6px_0_#000] transition-all">
                  <div class="flex items-center gap-4 w-full sm:w-auto">
                    <div class={`text-3xl font-display font-black ${isTop ? 'text-[var(--color-brand-accent)]' : 'text-gray-400'}`}>
                      #{i + 1}
                    </div>
                    <div>
                      <div class="font-bold text-lg uppercase">
                        {run.displayName || run.username || `Anonymous Runner #${run.id.slice(0, 5)}`}
                      </div>
                      <div class="text-xs text-gray-500 font-bold">
                        {run.correctAnswers} correct • {accuracy}% accuracy
                      </div>
                    </div>
                  </div>

                  <div class="text-right w-full sm:w-auto border-t-2 sm:border-t-0 border-dashed border-gray-200 pt-2 sm:pt-0">
                    <div class="text-3xl font-display font-black text-[var(--color-brand-accent)]">
                      {run.score.toLocaleString()} <span class="text-sm font-mono text-black font-bold">PTS</span>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="bg-white border-4 border-black p-8 text-center shadow-[4px_4px_0_#000]">
            <p class="font-bold uppercase tracking-wider text-gray-500 mb-4">No ranked runs recorded yet today</p>
            <a
              href="/play"
              class="inline-block px-6 py-3 bg-black text-white font-bold font-mono uppercase tracking-widest hover:bg-gray-800"
            >
              Play a game to set the high score →
            </a>
          </div>
        )}
      </section>

      {/* SECTION 2: DUEL ARENA BOT MASTERS */}
      <section class="mb-12">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-display font-black uppercase tracking-wider">
            ⚔️ Duel Arena AI Masters
          </h2>
          <span class="text-xs text-gray-500 font-bold uppercase">Bonus Round Guardians</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
          {duelBots.map(bot => (
            <div class="bg-white border-4 border-black p-4 sm:p-6 flex flex-col justify-between shadow-[4px_4px_0_#000] hover:-translate-y-1 hover:shadow-[8px_8px_0_#000] transition-all">
              <div>
                <div class="text-4xl mb-3">{bot.avatar}</div>
                <div class="inline-block px-2.5 py-0.5 bg-black text-white text-[10px] font-bold uppercase tracking-widest mb-2">
                  {bot.tier}
                </div>
                <h3 class="text-xl font-display font-black uppercase mb-1">{bot.name}</h3>
                <div class="text-xs font-bold text-gray-500 mb-3">Rating: <strong class="text-black">{bot.elo} ELO</strong></div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4 line-clamp-3">{bot.description}</p>
              </div>

              <div class="border-t-2 border-dashed border-gray-300 pt-3 flex justify-between items-center text-xs font-bold">
                <span class="text-gray-500">Style: {bot.style}</span>
                <span class="text-green-700">Win: {bot.winRate}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <div class="text-center mt-12">
        <a 
          href="/" 
          class="inline-block px-8 py-4 bg-white border-4 border-black font-bold font-mono uppercase tracking-widest hover:-translate-y-1 hover:shadow-[4px_4px_0_#000] active:translate-y-0 active:shadow-none transition-all"
        >
          ← Back to Game
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .grid-bg {
    background-size: 40px 40px;
    background-image: 
      linear-gradient(to right, rgba(0,0,0,0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0,0,0,0.05) 1px, transparent 1px);
  }
</style>
