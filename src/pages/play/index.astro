---
import Layout from '../../components/layout/Layout.astro';
import { db } from '../../lib/db';
import { categories } from '../../lib/db/schema/categories';
import { entities } from '../../lib/db/schema/entities';
import { eq, count } from 'drizzle-orm';

const cats = await db
  .select({
    id: categories.id,
    name: categories.name,
    slug: categories.slug,
    description: categories.description,
    icon: categories.icon,
    color: categories.color,
    entityCount: count(entities.id),
  })
  .from(categories)
  .leftJoin(entities, eq(entities.categoryId, categories.id))
  .groupBy(categories.id);

cats.sort((a, b) => Number(b.entityCount) - Number(a.entityCount));
---

<Layout title="Play">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex flex-col items-center max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-display font-bold text-center mb-4">SELECT CATEGORY</h1>
      <p class="text-[var(--color-brand-text-secondary)] text-center mb-12 font-mono text-lg">
        Choose a domain to start testing your intuition.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
        <a 
          href="/play/all" 
          style="--i: 0"
          class="relative flex items-center p-6 neo-glass hover:-translate-y-1 hover:shadow-[6px_6px_0_0_#000] transition-all duration-300 group overflow-hidden animate-slide-in-up [animation-delay:calc(var(--i)*60ms)] opacity-0 [animation-fill-mode:forwards]"
        >
          <div class="absolute left-0 top-0 bottom-0 w-2" style="background: var(--color-brand-accent)"></div>
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-[var(--color-brand-accent)] origin-left scale-x-0 transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-x-100"></div>
          <div class="text-5xl ml-2 mr-6 transition-transform group-hover:scale-110">🎲</div>
          <div class="flex-1 text-left">
            <h3 class="text-xl font-display font-bold">Anything</h3>
            <p class="text-sm text-[var(--color-brand-text-secondary)] mt-1">Mix all categories</p>
          </div>
        </a>

        {cats.map((cat, index) => (
          <a 
            href={`/play/${cat.slug}`}
            style={`--i: ${index + 1}`}
            class="relative flex items-center p-6 neo-glass hover:-translate-y-1 hover:shadow-[6px_6px_0_0_#000] transition-all duration-300 group overflow-hidden animate-slide-in-up [animation-delay:calc(var(--i)*60ms)] opacity-0 [animation-fill-mode:forwards]"
          >
            <div class="absolute left-0 top-0 bottom-0 w-2" style={`background: ${cat.color}`}></div>
            <div class="absolute bottom-0 left-0 right-0 h-1 origin-left scale-x-0 transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-x-100" style={`background: ${cat.color}`}></div>
            <div class="text-5xl ml-2 mr-6 transition-transform group-hover:scale-110">{cat.icon}</div>
            <div class="flex-1 text-left">
              <h3 class="text-xl font-display font-bold">{cat.name}</h3>
              <p class="text-sm text-[var(--color-brand-text-secondary)] mt-1 line-clamp-1">{cat.description}</p>
            </div>
            <div class="font-mono text-xs font-bold px-3 py-1.5 border-2 border-black text-black ml-4 whitespace-nowrap shadow-[2px_2px_0_#000]">
              {cat.entityCount}
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
