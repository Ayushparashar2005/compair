---
import Layout from '../../components/layout/Layout.astro';
import { DuelReplayViewer } from '../../components/duel/DuelReplayViewer';
import { db } from '../../lib/db';
import { duelSessions } from '../../lib/db/schema/duel_sessions';
import { eq } from 'drizzle-orm';

const { gameId } = Astro.params;

if (!gameId) {
  return Astro.redirect('/');
}

let sessionData = null;
let error = null;

try {
  const rows = await db.select().from(duelSessions).where(eq(duelSessions.id, gameId)).limit(1);
  if (rows.length > 0) {
    sessionData = {
      id: rows[0].id,
      state: rows[0].state,
      mode: rows[0].mode,
      status: rows[0].status,
      createdAt: rows[0].createdAt,
    };
  } else {
    error = 'Match replay not found';
  }
} catch (e: any) {
  error = e.message;
}

export const prerender = false;
---

<Layout title={`Match Replay #${gameId} | Compair`}>
  <main class="w-full min-h-screen bg-[#f4f4f0] text-black font-mono overflow-x-hidden relative py-12 px-4">
    <div class="max-w-4xl mx-auto relative z-10">
      
      <header class="mb-8 text-center md:text-left border-b-4 border-black pb-6">
        <a href="/" class="inline-block px-4 py-1.5 bg-black text-white text-xs font-bold uppercase tracking-widest mb-4 hover:bg-gray-800 transition-colors">
          ← Back to Game
        </a>
        <h1 class="text-4xl md:text-6xl font-display font-black tracking-tighter uppercase mb-2 [text-wrap:balance]">
          Duel Match Replay
        </h1>
        <p class="text-sm text-[var(--color-brand-text-secondary)]">
          Session ID: <span class="font-bold text-black">{gameId}</span>
        </p>
      </header>

      {error ? (
        <div class="bg-[var(--color-brand-incorrect)] border-4 border-black p-8 text-center shadow-[4px_4px_0_#000]">
          <h2 class="text-2xl font-bold font-display uppercase tracking-widest mb-4">Error loading replay</h2>
          <p class="font-mono mb-6">{error}</p>
          <a href="/" class="inline-block px-6 py-3 bg-black text-white font-bold uppercase text-xs">
            Return to Home
          </a>
        </div>
      ) : (
        <DuelReplayViewer 
          client:only="react" 
          gameId={gameId} 
          initialSessionData={sessionData} 
        />
      )}

    </div>
  </main>
</Layout>
